# 백엔드(facecook-be) 주소. WebSocket 주소도 여기서 파생된다(chatSocket.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# PostHog 사용 로그. 비워두면 수집 자체를 하지 않는다(analytics.ts가 no-op).
# 프로젝트 키는 원래 브라우저에 노출되는 값이라 NEXT_PUBLIC_이어도 된다.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# 세션 리플레이(화면 녹화). 동의를 받은 테스터 기간에만 true로 두고,
# 축제 기간에는 비워둔다 — 실제 참가자의 채팅 화면은 녹화 대상이 아니다.
NEXT_PUBLIC_POSTHOG_REPLAY=
